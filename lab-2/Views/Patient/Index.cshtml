@model List<lab_2.Models.Patient>

<div class="container py-4">
    <h2 class="text-center mb-4">Список пацієнтів</h2>

    @if (Model.Any())
    {
        <form asp-action="DeleteAll" method="post" class="mb-3 text-end" onsubmit="return confirm('Ви впевнені, що хочете видалити всіх пацієнтів?');">
            <button type="submit" class="btn btn-danger">Видалити всіх</button>
        </form>

        <table class="table table-striped table-bordered">
            <thead class="table-light">
            <tr>
                <th>Ім'я</th>
                <th>Вік</th>
                <th>Стать</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Age</td>
                    <td>@p.Gender</td>
                    <td class="text-end">
                        <form asp-action="Delete" method="post" asp-route-id="@p.Id" class="d-inline"
                              onsubmit="return confirm('Ви впевнені, що хочете видалити цього пацієнта?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Видалити</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-center text-muted">Поки що пацієнтів немає.</p>
    }

    <h3 class="mt-5 mb-3 text-center">Додати пацієнта</h3>

    <form asp-action="Index" method="post" class="d-flex flex-column gap-3 w-50 mx-auto">
        <input name="Name" class="form-control" placeholder="Ім'я" required />
        <input name="Age" type="number" class="form-control" placeholder="Вік" required />
        <input name="Gender" class="form-control" placeholder="Стать" required />
        <button type="submit" class="btn btn-primary w-100">Додати</button>
    </form>
</div>
