@model List<lab_2.Models.Employee>

<div class="container py-4">
    <h2 class="text-center mb-4">Список працівників</h2>

    @if (Model.Any())
    {
        <form asp-action="DeleteAll" method="post" class="mb-3 text-end" onsubmit="return confirm('Ви впевнені, що хочете видалити всіх працівників?');">
            <button type="submit" class="btn btn-danger">Видалити всіх</button>
        </form>

        <table class="table table-striped table-bordered">
            <thead class="table-light">
            <tr>
                <th>ПІБ</th>
                <th>Телефон</th>
                <th>Посада</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var emp in Model)
            {
                <tr>
                    <td>@emp.FullName</td>
                    <td>@emp.Phone</td>
                    <td>@emp.Position</td>
                    <td class="text-end">
                        <form asp-action="Delete" method="post" asp-route-id="@emp.Id" class="d-inline"
                              onsubmit="return confirm('Ви впевнені, що хочете видалити цього працівника?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Видалити</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-center text-muted">Поки що працівників немає.</p>
    }

    <h3 class="mt-5 mb-3 text-center">Додати працівника</h3>

    <form asp-action="Index" method="post" class="d-flex flex-column gap-3 w-50 mx-auto">
        <input name="FullName" class="form-control" placeholder="ПІБ" required />
        <input name="Phone" class="form-control" placeholder="Телефон" required />
        <input name="Position" class="form-control" placeholder="Посада" required />
        <button type="submit" class="btn btn-primary w-100">Додати</button>
    </form>
</div>
